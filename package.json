{
  "name": "tziakcha-fetcher",
  "version": "1.0.0",
  "description": "获取tziakcha牌谱数据并进行简单处理和统计，提供一些牌谱相关的实用工具。",
  "homepage": "https://github.com/tziakcha-stats/tziakcha-fetcher",
  "author": {
    "name": "Choimoe",
    "email": "qwq.shq@gmail.com",
    "url": "https://github.com/Choimoe"
  },
  "files": [
    "lib",
    "!lib/__tests__"
  ],
  "main": "lib/index.js",
  "keywords": [
    "nodejs",
    "javascript",
    "mahjong",
    "tziakcha"
  ],
  "devDependencies": {
    "coveralls": "^3.0.7",
    "eslint": "^6.6.0",
    "eslint-config-prettier": "^6.6.0",
    "eslint-config-xo": "^0.27.2",
    "eslint-plugin-prettier": "^3.1.1",
    "husky": "^3.0.9",
    "jest": "^26.1.0",
    "lint-staged": "^9.4.3",
    "prettier": "^1.19.1"
  },
  "engines": {
    "npm": ">= 4.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ],
    "*.json": [
      "prettier --write",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "eslintConfig": {
    "extends": [
      "xo",
      "prettier"
    ],
    "env": {
      "jest": true,
      "node": true
    },
    "rules": {
      "prettier/prettier": "error"
    },
    "plugins": [
      "prettier"
    ]
  },
  "scripts": {
    "pretest": "eslint .",
    "test": "jest",
    "prepack": "npm test -- --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tziakcha-stats/tziakcha-fetcher.git"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/lib/__tests__/**/*.test.js"
    ]
  },
  "license": "Apache-2.0",
  "dependencies": {
    "gb-mahjong-js": "^1.0.1"
  }
}
